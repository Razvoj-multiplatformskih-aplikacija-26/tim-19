# Razvojne vrednosti. Kopirajte u .env (van repozitorijuma) i pokrenite: docker compose up -d
POSTGRES_USER=soundconnect
POSTGRES_PASSWORD=soundconnect
POSTGRES_DB=soundconnect
POSTGRES_PORT=5435
SERVER_PORT=8080
ADMINER_PORT=8082

# Backoffice u pregledaču: flutter run -d chrome --web-port 8081
CORS_ORIGINS=http://localhost:8081

# Koliko minuta važi prijava (za proveru isteka na odbrani: 1).
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false

# Lozinka svih demo naloga (klijent1, klijent2, pruzalac1, moderator1); u bazi je samo Argon2id heš.
DEMO_PASSWORD=soundconnect-demo

# Tajna za potpis prijave, bar 32 bajta. Samo za razvoj.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# Ključ spoljnog servisa za obaveštenja; za KT2 lažna implementacija, ključ je samo na serveru.
NOTIFY_API_KEY=dev-fake-notify-key

# Za server pokrenut van Docker-a (dart run u apps/server) i testove servera.
DATABASE_URL=postgres://soundconnect:soundconnect@localhost:5435/soundconnect?sslmode=disable
